    <script>
      const mobileMenuToggle = document.querySelector("#mobile-menu-toggle");
      const mobileNavigation = document.querySelector("#mobile-navigation");
      const mobileMenuIconOpen = document.querySelector("#mobile-menu-icon-open");
      const mobileMenuIconClose = document.querySelector("#mobile-menu-icon-close");

      function setMobileMenuOpen(open) {
        if (!mobileMenuToggle || !mobileNavigation) return;

        mobileMenuToggle.setAttribute("aria-expanded", String(open));
        mobileMenuToggle.setAttribute(
          "aria-label",
          open ? "Закрыть меню" : "Открыть меню"
        );
        mobileNavigation.classList.toggle("hidden", !open);
        mobileNavigation.inert = !open;
        mobileMenuIconOpen?.classList.toggle("hidden", open);
        mobileMenuIconClose?.classList.toggle("hidden", !open);
      }

      mobileMenuToggle?.addEventListener("click", () => {
        const isOpen = mobileMenuToggle.getAttribute("aria-expanded") === "true";
        setMobileMenuOpen(!isOpen);
      });

      mobileNavigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMobileMenuOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          mobileMenuToggle?.getAttribute("aria-expanded") === "true"
        ) {
          setMobileMenuOpen(false);
          mobileMenuToggle.focus();
        }
      });

      window.addEventListener("resize", () => {
        if (window.matchMedia("(min-width: 768px)").matches) {
          setMobileMenuOpen(false);
        }
      });

      const form = document.querySelector("#order-form");
      const submitButton = document.querySelector("#order-submit");
      const status = document.querySelector("#order-status");
      const frame = document.querySelector("#form-submit-frame");

      let submitted = false;
      let submissionTimeout;

      function finishUnconfirmedSubmission() {
        if (!submitted || !form || !submitButton || !status) return;

        submitted = false;
        window.clearTimeout(submissionTimeout);
        form.removeAttribute("aria-busy");
        submitButton.disabled = false;
        submitButton.textContent = "Отправить заявку";
        status.textContent =
          "Не удалось подтвердить, принял ли сервис заявку. Ваши данные сохранены в форме. Если вы не получите ответа, свяжитесь с нами по телефону.";
        status.classList.remove("hidden");
      }

      function finishSubmittedRequest() {
        if (!submitted || !form || !submitButton || !status) return;

        submitted = false;
        window.clearTimeout(submissionTimeout);
        form.removeAttribute("aria-busy");
        form.reset();
        submitButton.disabled = false;
        submitButton.textContent = "Отправить заявку";
        status.textContent =
          "Ваша заявка принята! Мы свяжемся с вами для уточнения деталей.";
        status.classList.remove("hidden");
      }

      form?.addEventListener("submit", () => {
        if (!form || !submitButton || !status) return;

        submitted = true;
        form.setAttribute("aria-busy", "true");
        submitButton.disabled = true;
        submitButton.textContent = "Отправляем...";
        status.textContent = "Отправляем заявку. Пожалуйста, подождите…";
        status.classList.remove("hidden");
        window.clearTimeout(submissionTimeout);
        submissionTimeout = window.setTimeout(
          finishUnconfirmedSubmission,
          20000
        );
      });

      frame?.addEventListener("load", () => {
        // Ignore the iframe's initial load; this only signals a response after submission.
        finishSubmittedRequest();
      });

      frame?.addEventListener("error", () => {
        finishUnconfirmedSubmission();
      });
    </script>
<script>
  const galleries = {
    production: {
      title: "Производство",
      images: [
        `/optimized/gallery/production/01.webp`,
        `/optimized/gallery/production/02.webp`,
        `/optimized/gallery/production/03.webp`,
        `/optimized/gallery/production/04.webp`,
