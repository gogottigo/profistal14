---
import "../styles/global.css";

const categories = [
  {
    title: "Лофт-мебель",
    description: "Столы, стеллажи, кровати и мебель из металла",
  },
  {
    title: "Мангалы и зоны отдыха",
    description: "Мангалы, мангальные комплексы и зоны отдыха",
  },
  {
    title: "Заборы и ворота",
    description: "Изготовление и монтаж металлических конструкций",
  },
  {
    title: "Скамейки и качели",
    description: "Для частных участков, парков и общественных пространств",
  },
  {
    title: "Перила и ограждения",
    description: "Перила, ограждения и фальшбалконы",
  },
  {
    title: "Светильники",
    description: "Люстры, бра и декоративные светильники",
  },
  {
    title: "Чаны с подогревом",
    description: "Чаны для воды с системой обогрева",
  },
  {
    title: "Гаражи и беседки",
    description: "Металлические конструкции по индивидуальным размерам",
  },
];

const advantages = [
  "Изготовление по индивидуальным размерам",
  "Собственное производство",
  "Доставка и монтаж",
  "Изготовление от идеи до готового изделия",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ПрофиСталь 14 — изготовление изделий и конструкций из металла на заказ."
    />
    <title>ПрофиСталь 14 — изделия из металла на заказ</title>
  </head>

  <body class="bg-zinc-950 text-white antialiased">

    <!-- HEADER -->
    <header class="absolute top-0 left-0 z-50 w-full">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">

        <a href="/" class="group">
          <div class="text-xl font-black tracking-tight">
            ПРОФИ<span class="text-orange-500">СТАЛЬ</span>
            <span class="ml-1 text-sm font-bold text-zinc-400">14</span>
          </div>

          <div class="mt-0.5 text-[9px] uppercase tracking-[0.25em] text-zinc-500">
            От идеи до реализации
          </div>
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-zinc-300 md:flex">
          <a href="#catalog" class="transition hover:text-white">Изделия</a>
          <a href="#works" class="transition hover:text-white">Работы</a>
          <a href="#about" class="transition hover:text-white">О компании</a>
          <a href="#contacts" class="transition hover:text-white">Контакты</a>
        </nav>

        <a
          href="#order"
          class="rounded-full bg-orange-500 px-5 py-2.5 text-sm font-bold text-black transition hover:bg-orange-400"
        >
          Заказать
        </a>

      </div>
    </header>


    <!-- HERO -->
    <main>

      <section class="relative flex min-h-screen items-center overflow-hidden">

        <!-- Background -->
        <div class="absolute inset-0 bg-zinc-950"></div>

        <!-- Decorative grid -->
        <div
          class="absolute inset-0 opacity-[0.08]"
          style="
            background-image:
              linear-gradient(rgba(255,255,255,.3) 1px, transparent 1px),
              linear-gradient(90deg, rgba(255,255,255,.3) 1px, transparent 1px);
            background-size: 80px 80px;
          "
        ></div>

        <!-- Orange glow -->
        <div class="absolute -right-40 top-1/4 h-[500px] w-[500px] rounded-full bg-orange-600/10 blur-[140px]"></div>

        <div class="relative mx-auto w-full max-w-7xl px-6 py-32 lg:px-8">

          <div class="max-w-4xl">

            <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.25em] text-orange-500">
              <span class="h-px w-10 bg-orange-500"></span>
              Изделия из металла
            </div>

            <h1 class="text-5xl font-black leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
              МЕТАЛЛ,
              <br />
              КОТОРЫЙ
              <span class="text-orange-500">РАБОТАЕТ.</span>
            </h1>

            <p class="mt-8 max-w-xl text-lg leading-relaxed text-zinc-400">
              Изготавливаем изделия и конструкции из металла
              по вашим размерам и проектам — от небольшой
              детали до комплексного объекта.
            </p>

            <div class="mt-10 flex flex-wrap gap-4">
              <a
                href="#catalog"
                class="rounded-full bg-orange-500 px-7 py-4 font-bold text-black transition hover:bg-orange-400"
              >
                Смотреть изделия
              </a>

              <a
                href="#order"
                class="rounded-full border border-zinc-700 px-7 py-4 font-bold text-white transition hover:border-zinc-500"
              >
                Рассчитать стоимость
              </a>
            </div>

          </div>

        </div>

        <!-- Bottom label -->
        <div class="absolute bottom-8 left-6 right-6 mx-auto flex max-w-7xl justify-between text-xs uppercase tracking-[0.2em] text-zinc-600 lg:left-8 lg:right-8">
          <span>ПРОФИСТАЛЬ 14</span>
          <span class="hidden sm:block">ЯКУТСК</span>
        </div>

      </section>


      <!-- CATALOG -->
      <section id="catalog" class="bg-zinc-900 py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-orange-500">
                Каталог
              </p>

              <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
                ЧТО МЫ ДЕЛАЕМ
              </h2>
            </div>

            <p class="max-w-md text-zinc-400">
              Изготавливаем изделия серийно и по индивидуальным
              проектам. Если нужного варианта нет в каталоге —
              просто расскажите нам свою идею.
            </p>

          </div>


          <div class="grid gap-px overflow-hidden rounded-2xl bg-zinc-700 sm:grid-cols-2 lg:grid-cols-4">

            {categories.map((category, index) => (
              <a
                href="#order"
                class="group min-h-64 bg-zinc-900 p-7 transition hover:bg-zinc-800"
              >

                <div class="flex h-full flex-col justify-between">

                  <div>
                    <span class="text-xs font-bold text-zinc-600">
                      0{index + 1}
                    </span>

                    <h3 class="mt-12 text-xl font-bold">
                      {category.title}
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-zinc-500 transition group-hover:text-zinc-400">
                      {category.description}
                    </p>
                  </div>

                  <div class="mt-8 flex items-center justify-between">

                    <span class="text-sm font-bold text-orange-500">
                      Заказать
                    </span>

                    <span class="text-xl text-zinc-600 transition group-hover:translate-x-1 group-hover:text-orange-500">
                      →
                    </span>

                  </div>

                </div>

              </a>
            ))}

          </div>

        </div>

      </section>


      <!-- ADVANTAGES -->
      <section class="border-y border-zinc-800 bg-zinc-950 py-20">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

            {advantages.map((advantage, index) => (
              <div class="flex gap-4">

                <span class="text-sm font-bold text-orange-500">
                  0{index + 1}
                </span>

                <p class="font-semibold leading-relaxed text-zinc-300">
                  {advantage}
                </p>

              </div>
            ))}

          </div>

        </div>

      </section>


      <!-- WORKS -->
      <section id="works" class="bg-zinc-900 py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14">
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-orange-500">
              Портфолио
            </p>

            <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
              НАШИ РАБОТЫ
            </h2>
          </div>

          <div class="grid gap-4 md:grid-cols-2">

            <div class="flex min-h-80 items-end rounded-2xl bg-zinc-800 p-8">
              <div>
                <p class="text-sm text-orange-500">В цеху</p>
                <h3 class="mt-2 text-2xl font-bold">Производство</h3>
              </div>
            </div>

            <div class="flex min-h-80 items-end rounded-2xl bg-zinc-800 p-8">
              <div>
                <p class="text-sm text-orange-500">На объектах</p>
                <h3 class="mt-2 text-2xl font-bold">Готовые проекты</h3>
              </div>
            </div>

          </div>

        </div>

      </section>


      <!-- ABOUT -->
      <section id="about" class="bg-zinc-950 py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="grid gap-16 lg:grid-cols-2 lg:items-center">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-orange-500">
                О компании
              </p>

              <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
                ОТ ИДЕИ<br />
                ДО РЕАЛИЗАЦИИ
              </h2>
            </div>

            <div class="text-lg leading-relaxed text-zinc-400">
              <p>
                ПрофиСталь 14 — производство изделий и конструкций
                из металла на заказ.
              </p>

              <p class="mt-6">
                Проектируем, изготавливаем и устанавливаем
                металлические изделия под задачи клиента.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- ORDER -->
      <section id="order" class="bg-orange-500 py-24 text-black lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="max-w-3xl">

            <p class="text-sm font-black uppercase tracking-[0.2em]">
              Есть идея?
            </p>

            <h2 class="mt-4 text-5xl font-black tracking-tight sm:text-7xl">
              ДАВАЙТЕ<br />
              ЕЁ РЕАЛИЗУЕМ.
            </h2>

            <p class="mt-6 max-w-xl text-lg text-black/70">
              Оставьте контакты и кратко расскажите, что вам нужно.
              Мы свяжемся с вами и рассчитаем стоимость.
            </p>
<iframe
  name="form-submit-frame"
  id="form-submit-frame"
  class="hidden"
></iframe>
            <form
  id="order-form"
  class="mt-10 max-w-xl space-y-4"
  action="https://script.google.com/macros/s/AKfycbz9W5W8VQKRTn7sxlnuT05CB5JnyHpBLHdUO0klWEt5wjP71IG8ykboGMUfRA-1DJSZ/exec"
  method="POST"
  target="form-submit-frame"
>
  <input
    type="text"
    name="name"
    placeholder="Ваше имя *"
    required
    autocomplete="name"
    class="w-full rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  />

  <input
    type="tel"
    name="phone"
    placeholder="Номер телефона *"
    required
    autocomplete="tel"
    class="w-full rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  />

  <select
    name="product"
    required
    class="w-full appearance-none rounded-xl border-0 bg-black/10 px-5 py-4 text-black/70 outline-none focus:ring-2 focus:ring-black"
  >
    <option value="">Что хотите заказать? *</option>
    {categories.map((category) => (
      <option value={category.title}>
        {category.title}
      </option>
    ))}
    <option value="Другое">Другое</option>
  </select>

  <input
    type="text"
    name="size"
    placeholder="Размеры"
    class="w-full rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  />

  <input
    type="number"
    name="quantity"
    min="1"
    placeholder="Количество"
    class="w-full rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  />

  <textarea
    name="comment"
    rows="4"
    placeholder="Расскажите подробнее о заказе"
    class="w-full resize-none rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  ></textarea>

  <input
    type="email"
    name="email"
    placeholder="E-mail (необязательно)"
    autocomplete="email"
    class="w-full rounded-xl border-0 bg-black/10 px-5 py-4 placeholder:text-black/50 outline-none focus:ring-2 focus:ring-black"
  />

  <button
    id="order-submit"
    type="submit"
    class="w-full rounded-xl bg-black px-6 py-4 font-bold text-white transition hover:bg-zinc-900 disabled:cursor-not-allowed disabled:opacity-50"
  >
    Отправить заявку
  </button>

  <p
    id="order-status"
    class="hidden rounded-xl bg-black/10 px-5 py-4 text-sm font-semibold"
  ></p>
</form>

          </div>

        </div>

      </section>

    </main>


    <!-- FOOTER -->
    <footer id="contacts" class="bg-black py-12">

      <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8">

        <div>
          <div class="text-xl font-black">
            ПРОФИ<span class="text-orange-500">СТАЛЬ</span>
            <span class="ml-1 text-sm text-zinc-500">14</span>
          </div>

          <p class="mt-2 text-sm text-zinc-600">
            От идеи до реализации
          </p>
        </div>

        <div class="text-sm text-zinc-500 lg:text-right">
          <p>Якутск</p>
          <p class="mt-1">Телефон: +7 (___) ___-__-__</p>
          <p class="mt-4 text-xs text-zinc-700">
            © 2026 ПрофиСталь 14
          </p>
        </div>

      </div>

    </footer>
<script>
  const form = document.querySelector("#order-form");
  const submitButton = document.querySelector("#order-submit");
  const status = document.querySelector("#order-status");
  const frame = document.querySelector("#form-submit-frame");

  let submitted = false;

  form?.addEventListener("submit", () => {
    if (!form || !submitButton || !status) return;

    submitted = true;

    submitButton.disabled = true;
    submitButton.textContent = "Отправляем...";

    status.classList.add("hidden");
    status.textContent = "";
  });

  frame?.addEventListener("load", () => {
    if (!submitted || !form || !submitButton || !status) return;

    submitted = false;

    form.reset();

    submitButton.disabled = false;
    submitButton.textContent = "Отправить заявку";

    status.textContent =
      "Заявка отправлена! Мы свяжемся с вами для уточнения деталей.";
    status.classList.remove("hidden");
  });
</script>
  </body>
</html>