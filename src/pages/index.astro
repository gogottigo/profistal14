---
import "../styles/global.css";

const categories = [
  {
    title: "Лофт-мебель",
    description: "Столы, стеллажи, кровати и мебель из металла",
  },
  {
    title: "Мангалы и зоны отдыха",
    description: "Мангалы, мангальные комплексы и зоны отдыха",
  },
  {
    title: "Заборы и ворота",
    description: "Изготовление и монтаж металлических конструкций",
  },
  {
    title: "Скамейки и качели",
    description: "Для частных участков, парков и общественных пространств",
  },
  {
    title: "Перила и ограждения",
    description: "Перила, ограждения и фальшбалконы",
  },
  {
    title: "Светильники",
    description: "Люстры, бра и декоративные светильники",
  },
  {
    title: "Чаны с подогревом",
    description: "Чаны для воды с системой обогрева",
  },
  {
    title: "Гаражи и беседки",
    description: "Металлические конструкции по индивидуальным размерам",
  },
];

const advantages = [
  "Изготовление по индивидуальным размерам",
  "Собственное производство",
  "Доставка и монтаж",
  "От идеи до готового изделия",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ПрофиСталь 14 — изготовление изделий и конструкций из металла на заказ в Якутске."
    />
    <title>ПрофиСталь 14 — изделия из металла на заказ</title>
  </head>

  <body class="bg-brand-bg text-brand-text antialiased">

    <!-- HEADER -->
    <header class="absolute left-0 top-0 z-50 w-full">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">

        <a href="/" class="group">
          <div class="text-xl font-black tracking-tight">
            ПРОФИ<span class="text-brand-accent">СТАЛЬ</span>
            <span class="ml-1 text-sm font-bold text-brand-muted">14</span>
          </div>

          <div class="mt-0.5 text-[9px] uppercase tracking-[0.25em] text-brand-muted">
            От идеи до реализации
          </div>
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-brand-muted md:flex">
          <a href="#catalog" class="transition hover:text-brand-text">Изделия</a>
          <a href="#works" class="transition hover:text-brand-text">Работы</a>
          <a href="#about" class="transition hover:text-brand-text">О компании</a>
          <a href="#contacts" class="transition hover:text-brand-text">Контакты</a>
        </nav>

        <a
          href="#order"
          class="rounded-full bg-brand-accent px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-accent-dark"
        >
          Заказать
        </a>

      </div>
    </header>


    <!-- HERO -->
    <main>

      <section class="relative flex min-h-screen items-center overflow-hidden bg-brand-bg">

        <!-- Decorative background -->
        <div class="pointer-events-none absolute inset-0">
          <div
            class="absolute right-0 top-0 h-full w-1/2 opacity-40"
            style="
              background-image:
                linear-gradient(rgba(139,94,60,.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(139,94,60,.06) 1px, transparent 1px);
              background-size: 70px 70px;
            "
          ></div>

          <div class="absolute -right-40 top-1/4 h-[500px] w-[500px] rounded-full bg-brand-accent/10 blur-[140px]"></div>
        </div>

        <div class="relative mx-auto w-full max-w-7xl px-6 py-32 lg:px-8">

          <div class="max-w-4xl">

            <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.25em] text-brand-accent">
              <span class="h-px w-10 bg-brand-accent"></span>
              Изделия из металла
            </div>

            <h1 class="text-5xl font-black leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">
              МЕТАЛЛ,
              <br />
              КОТОРЫЙ
              <span class="text-brand-accent">РАБОТАЕТ.</span>
            </h1>

            <p class="mt-8 max-w-xl text-lg leading-relaxed text-brand-muted">
              Изготавливаем изделия и конструкции из металла
              по вашим размерам и проектам — от небольшой
              детали до комплексного объекта.
            </p>

            <div class="mt-10 flex flex-wrap gap-4">
              <a
                href="#catalog"
                class="rounded-full bg-brand-accent px-7 py-4 font-bold text-white transition hover:bg-brand-accent-dark"
              >
                Смотреть изделия
              </a>

              <a
                href="#order"
                class="rounded-full border border-brand-border px-7 py-4 font-bold text-brand-text transition hover:border-brand-accent hover:text-brand-accent"
              >
                Рассчитать стоимость
              </a>
            </div>

          </div>

        </div>

        <div class="absolute bottom-8 left-6 right-6 mx-auto flex max-w-7xl justify-between text-xs uppercase tracking-[0.2em] text-brand-muted lg:left-8 lg:right-8">
          <span>ПРОФИСТАЛЬ 14</span>
          <span class="hidden sm:block">ЯКУТСК</span>
        </div>

      </section>


      <!-- CATALOG -->
      <section id="catalog" class="bg-brand-section py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
                Каталог
              </p>

              <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
                ЧТО МЫ ДЕЛАЕМ
              </h2>
            </div>

            <p class="max-w-md text-brand-muted">
              Изготавливаем изделия серийно и по индивидуальным
              проектам. Если нужного варианта нет в каталоге —
              просто расскажите нам свою идею.
            </p>

          </div>


          <div class="grid overflow-hidden rounded-2xl border border-brand-border bg-brand-border sm:grid-cols-2 lg:grid-cols-4">

            {categories.map((category, index) => (
              <a
                href="#order"
                class="group min-h-64 bg-white p-7 transition hover:bg-[#faf8f5]"
              >

                <div class="flex h-full flex-col justify-between">

                  <div>
                    <span class="text-xs font-bold text-brand-muted/60">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <h3 class="mt-12 text-xl font-bold">
                      {category.title}
                    </h3>

                    <p class="mt-3 text-sm leading-relaxed text-brand-muted">
                      {category.description}
                    </p>
                  </div>

                  <div class="mt-8 flex items-center justify-between">

                    <span class="text-sm font-bold text-brand-accent">
                      Заказать
                    </span>

                    <span class="text-xl text-brand-muted/50 transition group-hover:translate-x-1 group-hover:text-brand-accent">
                      →
                    </span>

                  </div>

                </div>

              </a>
            ))}

          </div>

        </div>

      </section>


      <!-- ADVANTAGES -->
      <section class="border-y border-brand-border bg-white py-20">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

            {advantages.map((advantage, index) => (
              <div class="flex gap-4">

                <span class="text-sm font-bold text-brand-accent">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <p class="font-semibold leading-relaxed text-brand-text">
                  {advantage}
                </p>

              </div>
            ))}

          </div>

        </div>

      </section>


      <!-- WORKS -->
      <section id="works" class="bg-brand-bg py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14">
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
              Портфолио
            </p>

            <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
              НАШИ РАБОТЫ
            </h2>
          </div>


          <div class="grid gap-5 md:grid-cols-2">

            <div class="group relative flex min-h-80 items-end overflow-hidden rounded-2xl border border-brand-border bg-brand-section p-8 transition hover:border-brand-accent">

              <div class="relative z-10">
                <p class="text-sm font-semibold text-brand-accent">
                  В цеху
                </p>

                <h3 class="mt-2 text-2xl font-bold">
                  Производство
                </h3>
              </div>

              <div class="absolute right-8 top-8 text-6xl font-black text-brand-accent/10">
                01
              </div>

            </div>


            <div class="group relative flex min-h-80 items-end overflow-hidden rounded-2xl border border-brand-border bg-brand-section p-8 transition hover:border-brand-accent">

              <div class="relative z-10">
                <p class="text-sm font-semibold text-brand-accent">
                  На объектах
                </p>

                <h3 class="mt-2 text-2xl font-bold">
                  Готовые проекты
                </h3>
              </div>

              <div class="absolute right-8 top-8 text-6xl font-black text-brand-accent/10">
                02
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- ABOUT -->
      <section id="about" class="bg-white py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="grid gap-16 lg:grid-cols-2 lg:items-center">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
                О компании
              </p>

              <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
                ОТ ИДЕИ
                <br />
                ДО РЕАЛИЗАЦИИ
              </h2>
            </div>

            <div class="text-lg leading-relaxed text-brand-muted">

              <p>
                ПрофиСталь 14 — производство изделий и конструкций
                из металла на заказ.
              </p>

              <p class="mt-6">
                Проектируем, изготавливаем и устанавливаем
                металлические изделия под задачи клиента.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- ORDER -->
      <section id="order" class="bg-brand-accent py-24 text-white lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="max-w-3xl">

            <p class="text-sm font-black uppercase tracking-[0.2em] text-white/80">
              Есть идея?
            </p>

            <h2 class="mt-4 text-5xl font-black tracking-tight sm:text-7xl">
              ДАВАЙТЕ
              <br />
              ЕЁ РЕАЛИЗУЕМ.
            </h2>

            <p class="mt-6 max-w-xl text-lg text-white/75">
              Оставьте контакты и кратко расскажите, что вам нужно.
              Мы свяжемся с вами и рассчитаем стоимость.
            </p>


            <iframe
              name="form-submit-frame"
              id="form-submit-frame"
              class="hidden"
            ></iframe>


            <form
              id="order-form"
              class="mt-10 max-w-xl space-y-4"
              action="https://script.google.com/macros/s/AKfycbz9W5W8VQKRTn7sxlnuT05CB5JnyHpBLHdUO0klWEt5wjP71IG8ykboGMUfRA-1DJSZ/exec"
              method="POST"
              target="form-submit-frame"
            >

              <input
                type="text"
                name="name"
                placeholder="Ваше имя *"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="tel"
                name="phone"
                placeholder="Номер телефона *"
                required
                autocomplete="tel"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <select
                name="product"
                required
                class="w-full appearance-none rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white outline-none focus:ring-2 focus:ring-white"
              >
                <option value="" class="text-brand-text">Что хотите заказать? *</option>

                {categories.map((category) => (
                  <option value={category.title} class="text-brand-text">
                    {category.title}
                  </option>
                ))}

                <option value="Другое" class="text-brand-text">
                  Другое
                </option>
              </select>

              <input
                type="text"
                name="size"
                placeholder="Размеры"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="number"
                name="quantity"
                min="1"
                placeholder="Количество"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <textarea
                name="comment"
                rows="4"
                placeholder="Расскажите подробнее о заказе"
                class="w-full resize-none rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              ></textarea>

              <input
                type="email"
                name="email"
                placeholder="E-mail (необязательно)"
                autocomplete="email"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <button
                id="order-submit"
                type="submit"
                class="w-full rounded-xl bg-white px-6 py-4 font-bold text-brand-accent transition hover:bg-brand-bg disabled:cursor-not-allowed disabled:opacity-50"
              >
                Отправить заявку
              </button>

              <p
                id="order-status"
                class="hidden rounded-xl bg-white/15 px-5 py-4 text-sm font-semibold"
              ></p>

            </form>

          </div>

        </div>

      </section>

    </main>


    <!-- FOOTER -->
    <footer id="contacts" class="bg-brand-text py-12 text-white">

      <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8">

        <div>

          <div class="text-xl font-black">
            ПРОФИ<span class="text-brand-accent">СТАЛЬ</span>
            <span class="ml-1 text-sm text-white/40">14</span>
          </div>

          <p class="mt-2 text-sm text-white/50">
            От идеи до реализации
          </p>

        </div>


        <div class="text-sm text-white/50 lg:text-right">

          <p>Якутск</p>

          <p class="mt-1">
            Телефон: +7 (___) ___-__-__
          </p>

          <p class="mt-4 text-xs text-white/30">
            © 2026 ПрофиСталь 14
          </p>

        </div>

      </div>

    </footer>


    <script>
      const form = document.querySelector("#order-form");
      const submitButton = document.querySelector("#order-submit");
      const status = document.querySelector("#order-status");
      const frame = document.querySelector("#form-submit-frame");

      let submitted = false;

      form?.addEventListener("submit", () => {
        if (!form || !submitButton || !status) return;

        submitted = true;

        submitButton.disabled = true;
        submitButton.textContent = "Отправляем...";

        status.classList.add("hidden");
        status.textContent = "";
      });

      frame?.addEventListener("load", () => {
        if (!submitted || !form || !submitButton || !status) return;

        submitted = false;

        form.reset();

        submitButton.disabled = false;
        submitButton.textContent = "Отправить заявку";

        status.textContent =
          "Заявка отправлена! Мы свяжемся с вами для уточнения деталей.";

        status.classList.remove("hidden");
      });
    </script>

  </body>
</html>
