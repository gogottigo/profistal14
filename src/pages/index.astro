---
import "../styles/global.css";

const categories = [
  {
    id: "loft",
    image: "/optimized/categories/cat-01-loft-mebel.webp",
    title: "Лофт-мебель",
    description: "Столы, стеллажи, кровати и мебель из металла",
    gallery: Array.from({ length: 8 }, (_, i) =>
      `/optimized/products/loft/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "mangals",
    image: "/optimized/categories/cat-02-mangal-zony-otdyha.webp",
    title: "Мангалы и зоны отдыха",
    description: "Мангалы, мангальные комплексы и зоны отдыха",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/mangals/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "fences",
    image: "/optimized/categories/cat-03-zabor-vorota.webp",
    title: "Заборы и ворота",
    description: "Изготовление и монтаж металлических конструкций",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/fences/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "benches",
    image: "/optimized/categories/cat-04-skameyki-kacheli.webp",
    title: "Скамейки и качели",
    description: "Для частных участков, парков и общественных пространств",
    gallery: Array.from({ length: 7 }, (_, i) =>
      `/optimized/products/benches/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "perila",
    image: "/optimized/categories/cat-05-perila-ograzhdeniya.webp",
    title: "Перила и ограждения",
    description: "Перила, ограждения и фальшбалконы",
    gallery: Array.from({ length: 31 }, (_, i) =>
      `/optimized/products/perila/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "svetilniki",
    image: "/optimized/categories/cat-06-svetilniki.webp",
    title: "Светильники",
    description: "Люстры, бра и декоративные светильники",
    gallery: Array.from({ length: 8 }, (_, i) =>
      `/optimized/products/svetilniki/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "chany",
    image: "/optimized/categories/cat-07-chany-podogrevom.webp",
    title: "Чаны с подогревом",
    description: "Чаны для воды с системой обогрева",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/chany/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "besedka",
    image: "/optimized/categories/cat-08-garazhi-besedki.webp",
    title: "Гаражи и беседки",
    description: "Металлические конструкции по индивидуальным размерам",
    gallery: Array.from({ length: 8 }, (_, i) =>
      `/optimized/products/besedka/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
];

const advantages = [
  "📐 Изготовление по индивидуальным размерам",
  "🏭 Собственное производство",
  "🚚 Доставка и монтаж",
  "💡 От идеи до готового изделия",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ПрофиСталь 14 — изготовление изделий и конструкций из металла на заказ в Якутске."
    />
    <title>ПрофиСталь 14 — изделия из металла на заказ</title>
    <link rel="icon" type="image/png" href={`/favicon.png`} />
  </head>

  <body class="bg-brand-bg text-brand-text antialiased">

    <!-- HEADER -->
    <header class="absolute left-0 top-0 z-50 w-full">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">

        <a href="/" class="group block">
          <img
            src={`/profistal14_logo.webp`}
            alt="ПрофиСталь 14"
            class="h-auto w-[190px] object-contain transition-opacity group-hover:opacity-85 sm:w-[220px]"
          />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-brand-muted md:flex">
          <a href="#catalog" class="transition hover:text-brand-text">Изделия</a>
          <a href="#works" class="transition hover:text-brand-text">Работы</a>
          <a href="#about" class="transition hover:text-brand-text">О компании</a>
          <a href="#contacts" class="transition hover:text-brand-text">Контакты</a>
        </nav>

        <a
          href="#order"
          class="rounded-full bg-brand-accent px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-accent-dark"
        >
          Заказать
        </a>

      </div>
    </header>


    <!-- HERO -->
    <main>

<section class="relative flex min-h-screen items-center overflow-hidden bg-brand-bg">

  <!-- Hero background image -->
  <div class="pointer-events-none absolute inset-0">
    <img
      src={`/optimized/hero-bg.webp`}
      alt=""
      class="h-full w-full scale-105 object-cover blur-[5px]"
    />

    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0 bg-brand-bg/75"></div>
  </div>

  <!-- Decorative background -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute right-0 top-0 h-full w-1/2 opacity-40"
      style="
        background-image:
          linear-gradient(rgba(139,94,60,.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(139,94,60,.06) 1px, transparent 1px);
        background-size: 70px 70px;
      "
    ></div>

    <div class="absolute -right-40 top-1/4 h-[500px] w-[500px] rounded-full bg-brand-accent/10 blur-[140px]"></div>
  </div>

  <!-- Content -->
  <div class="relative mx-auto w-full max-w-7xl px-6 py-32 lg:px-8">

    <div class="max-w-4xl">

      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.25em] text-brand-accent">
        <span class="h-px w-10 bg-brand-accent"></span>
        Изделия из металла
      </div>

<h1 class="text-4xl font-black leading-[1.20] tracking-tight sm:text-7xl lg:text-8xl">
  МЕТАЛЛ,<br>
  КОТОРЫЙ
  <span class="text-brand-accent whitespace-nowrap">РАБОТАЕТ.</span>
</h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-brand-muted">
        Изготавливаем изделия и конструкции из металла
        по вашим размерам и проектам — от небольшой
        детали до комплексного объекта.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#catalog"
          class="rounded-full bg-brand-accent px-7 py-4 font-bold text-white transition hover:bg-brand-accent-dark"
        >
          Смотреть изделия
        </a>

        <a
          href="#order"
          class="rounded-full border border-brand-border px-7 py-4 font-bold text-brand-text transition hover:border-brand-accent hover:text-brand-accent"
        >
          Рассчитать стоимость
        </a>
      </div>

    </div>

  </div>

  <div class="absolute bottom-8 left-6 right-6 mx-auto flex max-w-7xl justify-between text-xs uppercase tracking-[0.2em] text-brand-muted lg:left-8 lg:right-8">
    <span>ПРОФИСТАЛЬ 14</span>
    <span class="hidden sm:block">ЯКУТСК</span>
  </div>

</section>


      <!-- CATALOG -->
      <section id="catalog" class="bg-brand-section py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
                Каталог
              </p>

              <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
                ЧТО МЫ ДЕЛАЕМ
              </h2>
            </div>

            <p class="max-w-md text-brand-muted">
              Изготавливаем изделия серийно и по индивидуальным
              проектам. Если нужного варианта нет в каталоге —
              просто расскажите нам свою идею.
            </p>

          </div>


<div
  id="catalog-grid"
  class="grid overflow-hidden rounded-2xl border border-brand-border bg-brand-border sm:grid-cols-2 lg:grid-cols-4"
  data-categories={JSON.stringify(categories)}
>
  {categories.map((category) => (
    <button
      type="button"
      class="category-card group relative min-h-[320px] overflow-hidden bg-[#f5f3ef] text-left"
      data-category-id={category.id}
    >
      <div class="absolute inset-0 flex items-center justify-center p-5">
        <img
          src={category.image}
          alt={category.title}
          loading="lazy"
          class="h-full w-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-white via-white/75 via-35% to-transparent"></div>

      <div class="relative flex min-h-[320px] flex-col justify-end p-6">
        <h3 class="text-xl font-bold leading-tight text-brand-text">
          {category.title}
        </h3>

        <p class="mt-3 max-w-[280px] text-sm leading-relaxed text-brand-muted">
          {category.description}
        </p>

        <div class="mt-6 flex items-center justify-between">
          <span class="text-sm font-bold text-brand-accent">
            Смотреть работы
          </span>

          <span class="text-xl text-brand-muted/50 transition-all duration-300 group-hover:translate-x-1 group-hover:text-brand-accent">
            →
          </span>
        </div>
      </div>
    </button>
  ))}
</div>
</div>
      </section>
<!-- Category gallery modal -->
<div
  id="category-modal"
  class="fixed inset-0 z-[100] hidden"
  aria-hidden="true"
>
  <!-- Background -->
  <div
    id="category-modal-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  ></div>

  <!-- Modal -->
  <div class="relative flex min-h-full items-center justify-center p-3 sm:p-6">
    <div
      id="category-modal-panel"
      class="relative flex max-h-[94vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
    >
      <!-- Header -->
      <div class="flex shrink-0 items-center justify-between border-b border-brand-border px-5 py-4 sm:px-7">
        <div>
          <h2
            id="category-modal-title"
            class="text-xl font-bold text-brand-text sm:text-2xl"
          ></h2>

          <p
            id="category-modal-count"
            class="mt-1 text-sm text-brand-muted"
          ></p>
        </div>

        <button
          id="category-modal-close"
          type="button"
          aria-label="Закрыть"
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-bg text-2xl leading-none text-brand-text transition hover:bg-brand-border"
        >
          ×
        </button>
      </div>

      <!-- Gallery -->
      <div
        id="category-modal-gallery"
        class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6"
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        </div>
      </div>

      <!-- Footer -->
<div class="shrink-0 border-t border-brand-border bg-white px-5 py-4 sm:px-7">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button
      id="category-modal-order"
      type="button"
      class="w-full rounded-xl bg-brand-accent px-6 py-3.5 text-center text-sm font-bold text-white transition hover:opacity-90 sm:w-auto"
    >
      Заказать
    </button>

    <p class="text-center text-sm italic text-brand-muted sm:text-left">
      Для участников СВО действует система скидок
    </p>
  </div>
</div>
    </div>
  </div>
</div>

      <!-- ADVANTAGES -->
      <section class="border-y border-brand-border bg-white py-20">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">

            {advantages.map((advantage) => (
  <div class="flex gap-4">
    <p class="font-semibold leading-relaxed text-brand-text">
      {advantage}
    </p>
  </div>
))}
          </div>

        </div>

      </section>


      <!-- WORKS -->
      <section id="works" class="bg-brand-bg py-24 lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="mb-14">
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
              Портфолио
            </p>

            <h2 class="text-4xl font-black tracking-tight sm:text-5xl">
              НАШИ РАБОТЫ
            </h2>
          </div>



        <div class="grid gap-5 md:grid-cols-2">

<button
  type="button"
  data-gallery="production"
  class="group relative flex min-h-80 w-full cursor-pointer items-end overflow-hidden rounded-2xl border border-brand-border bg-brand-section p-8 text-left transition hover:border-brand-accent"
>
  <!-- Фоновая фотография -->
  <img
    src={`/optimized/gallery/production/01.webp`}
    alt=""
    class="absolute inset-0 h-full w-full scale-105 object-cover blur-[2px] transition duration-500 group-hover:scale-110"
  />

  <!-- Затемнение -->
  <div class="absolute inset-0 bg-black/55 transition group-hover:bg-black/40"></div>

  <!-- Контент -->
  <div class="relative z-10">
    <p class="text-sm font-semibold text-brand-accent">
      В цеху
    </p>

    <h3 class="mt-2 text-2xl font-bold text-white">
      Производство
    </h3>

    <p class="mt-3 text-sm text-white/70 opacity-0 transition group-hover:opacity-100">
      Смотреть фотографии →
    </p>
  </div>


</button>


<button
  type="button"
  data-gallery="works"
  class="group relative flex min-h-80 w-full cursor-pointer items-end overflow-hidden rounded-2xl border border-brand-border bg-brand-section p-8 text-left transition hover:border-brand-accent"
>
  <!-- Фоновая фотография -->
  <img
    src={`/optimized/gallery/works/03.webp`}
    alt=""
    class="absolute inset-0 h-full w-full scale-105 object-cover blur-[2px] transition duration-500 group-hover:scale-110"
  />

  <!-- Затемнение -->
  <div class="absolute inset-0 bg-black/55 transition group-hover:bg-black/40"></div>

  <!-- Контент -->
  <div class="relative z-10">
    <p class="text-sm font-semibold text-brand-accent">
      На объектах
    </p>

    <h3 class="mt-2 text-2xl font-bold text-white">
      Готовые проекты
    </h3>

    <p class="mt-3 text-sm text-white/70 opacity-0 transition group-hover:opacity-100">
      Смотреть фотографии →
    </p>
  </div>

</button>

</div>

        </div>

      </section>
<div
  id="gallery-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
>
  <div
    id="gallery-content"
    class="relative w-full max-w-5xl rounded-2xl bg-brand-section p-5 shadow-2xl"
  >

    <!-- Закрыть -->
    <button
      id="gallery-close"
      type="button"
      class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-xl text-white transition hover:bg-brand-accent"
      aria-label="Закрыть"
    >
      ×
    </button>

    <h3
      id="gallery-title"
      class="mb-5 pr-12 text-2xl font-bold"
    ></h3>

    <!-- Большая картинка -->
    <div class="relative">
      <img
        id="gallery-image"
        src=""
        alt=""
        class="mx-auto max-h-[65vh] w-full rounded-xl object-contain"
      />

      <!-- Назад -->
      <button
        id="gallery-prev"
        type="button"
        class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white transition hover:bg-brand-accent"
      >
        ‹
      </button>

      <!-- Вперёд -->
      <button
        id="gallery-next"
        type="button"
        class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white transition hover:bg-brand-accent"
      >
        ›
      </button>
    </div>

    <!-- Миниатюры -->
    <div
      id="gallery-thumbnails"
      class="mt-4 flex gap-3 overflow-x-auto pb-2"
    ></div>

  </div>
</div>

 <!-- ABOUT -->
<section
  id="about"
  class="relative overflow-hidden bg-white py-24 lg:py-32"
>

  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src={`/optimized/about-bg.webp`}
      alt=""
      class="h-full w-full scale-105 object-cover blur-[6px]"
    />

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-black/7"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">

      <!-- Left side -->
      <div class="py-8">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
          О компании
        </p>

        <h2 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
          ОТ ИДЕИ
          <br />
          ДО РЕАЛИЗАЦИИ
        </h2>
      </div>

      <!-- Right side -->
      <div class="border border-white/20 bg-black/45 p-8 backdrop-blur-sm lg:p-10">

        <div class="text-lg leading-relaxed text-white/80">

          <p>
            ООО "ПрофиСталь14" это небольшое, но уверенное в себе производство.
            Наши товары производятся в Якутске и отпускаются по месту производства
            либо со склада в Якутске.
          </p>

          <p class="mt-6">
            Мы делаем простую и надёжную мебель, кованые изделия, элементы интерьера
            и полезные мелочи. Работаем с деревом, металлом, фанерой, ЛДСП;
            не гонимся за модой, зато внимательно подходим к каждой детали.
          </p>

          <p class="mt-6">
            Всё, что вы видите на сайте, мы изготавливаем сами.
          </p>

          <p class="mt-6">
            Часть позиций — типовые, часть делаем под заказ.
          </p>

          <p class="mt-6">
            Для бизнеса, для дома, для детских учреждений — делаем так, чтобы работало долго.
          </p>

          <p class="mt-6">
            Никаких «временных коллекций» и громких слов.
          </p>

          <p class="mt-6">
            Только то, что нужно.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>


      <!-- ORDER -->
      <section id="order" class="bg-brand-accent py-24 text-white lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="max-w-3xl">

            <p class="text-sm font-black uppercase tracking-[0.2em] text-white/80">
              Есть идея?
            </p>

            <h2 class="mt-4 text-5xl font-black tracking-tight sm:text-7xl">
              ДАВАЙТЕ
              <br />
              ЕЁ РЕАЛИЗУЕМ.
            </h2>

            <p class="mt-6 max-w-xl text-lg text-white/75">
              Оставьте контакты и кратко расскажите, что вам нужно.
              Мы свяжемся с вами и рассчитаем стоимость.
            </p>


            <iframe
              name="form-submit-frame"
              id="form-submit-frame"
              class="hidden"
            ></iframe>


            <form
              id="order-form"
              class="mt-10 max-w-xl space-y-4"
              action="https://script.google.com/macros/s/AKfycbz9W5W8VQKRTn7sxlnuT05CB5JnyHpBLHdUO0klWEt5wjP71IG8ykboGMUfRA-1DJSZ/exec"
              method="POST"
              target="form-submit-frame"
            >

              <input
                type="text"
                name="name"
                placeholder="Ваше имя *"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="tel"
                name="phone"
                placeholder="Номер телефона *"
                required
                autocomplete="tel"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <select
                name="product"
                required
                class="w-full appearance-none rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white outline-none focus:ring-2 focus:ring-white"
              >
                <option value="" class="text-brand-text">Что хотите заказать? *</option>

                {categories.map((category) => (
                  <option value={category.title} class="text-brand-text">
                    {category.title}
                  </option>
                ))}

                <option value="Другое" class="text-brand-text">
                  Другое
                </option>
              </select>

              <input
                type="text"
                name="size"
                placeholder="Размеры"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="number"
                name="quantity"
                min="1"
                placeholder="Количество"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <textarea
                name="comment"
                rows="4"
                placeholder="Расскажите подробнее о заказе"
