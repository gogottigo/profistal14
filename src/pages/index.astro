  />

  <!-- Затемнение -->
  <div class="absolute inset-0 bg-black/55 transition group-hover:bg-black/40"></div>

  <!-- Контент -->
  <div class="relative z-10">
    <p class="text-sm font-semibold text-brand-accent">
      В цеху
    </p>

    <h3 class="mt-2 text-2xl font-bold text-white">
      Производство
    </h3>

    <p class="mt-3 text-sm text-white/70 opacity-0 transition group-hover:opacity-100">
      Смотреть фотографии →
    </p>
  </div>


</button>


<button
  type="button"
  data-gallery="works"
  class="group relative flex min-h-80 w-full cursor-pointer items-end overflow-hidden rounded-2xl border border-brand-border bg-brand-section p-8 text-left transition hover:border-brand-accent"
>
  <!-- Фоновая фотография -->
  <img
    src={`/optimized/gallery/works/03.webp`}
    alt=""
    class="absolute inset-0 h-full w-full scale-105 object-cover blur-[2px] transition duration-500 group-hover:scale-110"
  />

  <!-- Затемнение -->
  <div class="absolute inset-0 bg-black/55 transition group-hover:bg-black/40"></div>

  <!-- Контент -->
  <div class="relative z-10">
    <p class="text-sm font-semibold text-brand-accent">
      На объектах
    </p>

    <h3 class="mt-2 text-2xl font-bold text-white">
      Готовые проекты
    </h3>

    <p class="mt-3 text-sm text-white/70 opacity-0 transition group-hover:opacity-100">
      Смотреть фотографии →
    </p>
  </div>

</button>

</div>

        </div>

      </section>
<div
  id="gallery-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
>
  <div
    id="gallery-content"
    class="relative w-full max-w-5xl rounded-2xl bg-brand-section p-5 shadow-2xl"
  >

    <!-- Закрыть -->
    <button
      id="gallery-close"
      type="button"
      class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-xl text-white transition hover:bg-brand-accent"
      aria-label="Закрыть"
    >
      ×
    </button>

    <h3
      id="gallery-title"
      class="mb-5 pr-12 text-2xl font-bold"
    ></h3>

    <!-- Большая картинка -->
    <div class="relative">
      <img
        id="gallery-image"
        src=""
        alt=""
        class="mx-auto max-h-[65vh] w-full rounded-xl object-contain"
      />

      <!-- Назад -->
      <button
        id="gallery-prev"
        type="button"
        class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white transition hover:bg-brand-accent"
      >
        ‹
      </button>

      <!-- Вперёд -->
      <button
        id="gallery-next"
        type="button"
        class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-2xl text-white transition hover:bg-brand-accent"
      >
        ›
      </button>
    </div>

    <!-- Миниатюры -->
    <div
      id="gallery-thumbnails"
      class="mt-4 flex gap-3 overflow-x-auto pb-2"
    ></div>

  </div>
</div>

 <!-- ABOUT -->
<section
  id="about"
  class="relative overflow-hidden bg-white py-24 lg:py-32"
>

  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src={`/optimized/about-bg.webp`}
      alt=""
      class="h-full w-full scale-105 object-cover blur-[6px]"
    />

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-black/7"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">

    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">

      <!-- Left side -->
      <div class="py-8">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
          О компании
        </p>

        <h2 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
          ОТ ИДЕИ
          <br />
          ДО РЕАЛИЗАЦИИ
        </h2>
      </div>

      <!-- Right side -->
      <div class="border border-white/20 bg-black/45 p-8 backdrop-blur-sm lg:p-10">

        <div class="text-lg leading-relaxed text-white/80">

          <p>
            ООО "ПрофиСталь14" это небольшое, но уверенное в себе производство.
            Наши товары производятся в Якутске и отпускаются по месту производства
            либо со склада в Якутске.
          </p>

          <p class="mt-6">
            Мы делаем простую и надёжную мебель, кованые изделия, элементы интерьера
            и полезные мелочи. Работаем с деревом, металлом, фанерой, ЛДСП;
            не гонимся за модой, зато внимательно подходим к каждой детали.
          </p>

          <p class="mt-6">
            Всё, что вы видите на сайте, мы изготавливаем сами.
          </p>

          <p class="mt-6">
            Часть позиций — типовые, часть делаем под заказ.
          </p>

          <p class="mt-6">
            Для бизнеса, для дома, для детских учреждений — делаем так, чтобы работало долго.
          </p>

          <p class="mt-6">
            Никаких «временных коллекций» и громких слов.
          </p>

          <p class="mt-6">
            Только то, что нужно.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>


      <!-- ORDER -->
      <section id="order" class="bg-brand-accent py-24 text-white lg:py-32">

        <div class="mx-auto max-w-7xl px-6 lg:px-8">

          <div class="max-w-3xl">

            <p class="text-sm font-black uppercase tracking-[0.2em] text-white/80">
              Есть идея?
            </p>

            <h2 class="mt-4 text-5xl font-black tracking-tight sm:text-7xl">
              ДАВАЙТЕ
              <br />
              ЕЁ РЕАЛИЗУЕМ.
            </h2>

            <p class="mt-6 max-w-xl text-lg text-white/75">
              Оставьте контакты и кратко расскажите, что вам нужно.
              Мы свяжемся с вами и рассчитаем стоимость.
            </p>


            <iframe
              name="form-submit-frame"
              id="form-submit-frame"
              class="hidden"
            ></iframe>


            <form
              id="order-form"
              class="mt-10 max-w-xl space-y-4"
              action="https://script.google.com/macros/s/AKfycbz9W5W8VQKRTn7sxlnuT05CB5JnyHpBLHdUO0klWEt5wjP71IG8ykboGMUfRA-1DJSZ/exec"
              method="POST"
              target="form-submit-frame"
            >

              <input
                type="text"
                name="name"
                placeholder="Ваше имя *"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="tel"
                name="phone"
                placeholder="Номер телефона *"
                required
                autocomplete="tel"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <select
                name="product"
                required
                class="w-full appearance-none rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white outline-none focus:ring-2 focus:ring-white"
              >
                <option value="" class="text-brand-text">Что хотите заказать? *</option>

                {categories.map((category) => (
                  <option value={category.title} class="text-brand-text">
                    {category.title}
                  </option>
                ))}

                <option value="Другое" class="text-brand-text">
                  Другое
                </option>
              </select>

              <input
                type="text"
                name="size"
                placeholder="Размеры"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <input
                type="number"
                name="quantity"
                min="1"
                placeholder="Количество"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <textarea
                name="comment"
                rows="4"
                placeholder="Расскажите подробнее о заказе"
                class="w-full resize-none rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              ></textarea>

              <input
                type="email"
                name="email"
                placeholder="E-mail (необязательно)"
                autocomplete="email"
                class="w-full rounded-xl border border-white/10 bg-white/15 px-5 py-4 text-white placeholder:text-white/55 outline-none focus:ring-2 focus:ring-white"
              />

              <button
                id="order-submit"
                type="submit"
                class="w-full rounded-xl bg-white px-6 py-4 font-bold text-brand-accent transition hover:bg-brand-bg disabled:cursor-not-allowed disabled:opacity-50"
              >
                Отправить заявку
              </button>

              <p
                id="order-status"
                class="hidden rounded-xl bg-white/15 px-5 py-4 text-sm font-semibold"
              ></p>

            </form>

          </div>

        </div>

      </section>

    </main>


    <!-- FOOTER -->
    <footer id="contacts" class="bg-brand-text py-12 text-white">

      <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8">

  <div>
    <img
      src={`/profistal14_box_logo.webp`}
      alt="ПрофиСталь 14"
      class="h-48 w-auto"
    />
  </div>


        <div class="text-sm text-white/50 lg:text-right">

<p>
  📍 Улица Тальниковая, 1/4<br />
  Марха м-н, Якутск, 677901
</p>

<p class="mt-4 w-full text-left">
  <a
    href="tel:+79143000818"
    class="transition hover:text-brand-accent"
  >
    ☎️ +7 (914) 300-08-18
  </a>
</p>

<div class="mt-4 flex flex-col items-start gap-2">
  <a
    href="https://wa.me/79143000818?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!%0A%0A%D0%9F%D0%B8%D1%88%D1%83%20%D0%B8%D0%B7%20%D0%B2%D0%B0%D1%88%D0%B5%D0%B3%D0%BE%20%D1%81%D0%B0%D0%B9%D1%82%D0%B0"
    target="_blank"
    rel="noopener noreferrer"
    class="transition hover:text-brand-accent"
  >
    🟢 Написать в WhatsApp →
  </a>

  <a
    href="https://max.ru/u/f9LHodD0cOITCI8gwaBHfZSrOMeiWprSrqpOTy3X9Ti645JbFQfa3i55JjY"
    target="_blank"
    rel="noopener noreferrer"
    class="transition hover:text-brand-accent"
  >
    Ⓜ️ Написать в MAX →
  </a>
</div>

<p class="mt-4 text-xs text-white/30">
  © 2026 ПрофиСталь 14
</p>

        </div>

      </div>

    </footer>


    <script>
      const form = document.querySelector("#order-form");
      const submitButton = document.querySelector("#order-submit");
      const status = document.querySelector("#order-status");
      const frame = document.querySelector("#form-submit-frame");

      let submitted = false;

      form?.addEventListener("submit", () => {
        if (!form || !submitButton || !status) return;

        submitted = true;

        submitButton.disabled = true;
        submitButton.textContent = "Отправляем...";

        status.classList.add("hidden");
        status.textContent = "";
      });

      frame?.addEventListener("load", () => {
        if (!submitted || !form || !submitButton || !status) return;

        submitted = false;

        form.reset();

        submitButton.disabled = false;
        submitButton.textContent = "Отправить заявку";

        status.textContent =
          "Заявка отправлена! Мы свяжемся с вами для уточнения деталей.";

        status.classList.remove("hidden");
      });
    </script>
<script>
  const galleries = {
    production: {
      title: "Производство",
      images: [
        `/optimized/gallery/production/01.webp`,
        `/gallery/production/02.png`,
        `/gallery/production/03.png`,
        `/gallery/production/04.png`,
      ],
    },

    works: {
      title: "Готовые проекты",
      images: [
        `/optimized/gallery/works/01.webp`,
        `/optimized/gallery/works/02.webp`,
        `/optimized/gallery/works/03.webp`,
        `/optimized/gallery/works/04.webp`,
        `/optimized/gallery/works/05.webp`,
        `/optimized/gallery/works/06.webp`,
        `/optimized/gallery/works/07.webp`,
        `/optimized/gallery/works/08.webp`,
        `/optimized/gallery/works/09.webp`,
        `/optimized/gallery/works/10.webp`,
        `/optimized/gallery/works/11.webp`,
        `/optimized/gallery/works/12.webp`,
        `/optimized/gallery/works/13.webp`,
        `/optimized/gallery/works/14.webp`,
        `/optimized/gallery/works/15.webp`,
        `/optimized/gallery/works/16.webp`,
      ],
    },
  };

  const modal = document.querySelector("#gallery-modal");
  const image = document.querySelector("#gallery-image");
  const title = document.querySelector("#gallery-title");
  const thumbnails = document.querySelector("#gallery-thumbnails");
  const close = document.querySelector("#gallery-close");
  const prev = document.querySelector("#gallery-prev");
  const next = document.querySelector("#gallery-next");

  let currentGallery = null;
  let currentIndex = 0;

  function showImage(index) {
    if (!currentGallery) return;

    currentIndex =
      (index + currentGallery.images.length) %
      currentGallery.images.length;

    image.src = currentGallery.images[currentIndex];

    thumbnails.innerHTML = "";

    currentGallery.images.forEach((src, i) => {
      const thumb = document.createElement("button");

      thumb.type = "button";
      thumb.className =
        "h-20 w-28 shrink-0 overflow-hidden rounded-lg border-2 transition";

      if (i === currentIndex) {
        thumb.classList.add("border-brand-accent");
      } else {
        thumb.classList.add("border-transparent");
      }

      const img = document.createElement("img");

      img.src = src;
      img.alt = "";
      img.className = "h-full w-full object-cover";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        showImage(i);
      });

      thumbnails.appendChild(thumb);
    });
  }

  function openGallery(name) {
    currentGallery = galleries[name];

    if (!currentGallery) return;

    currentIndex = 0;
    title.textContent = currentGallery.title;

    showImage(0);

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.body.style.overflow = "hidden";
  }

  function closeGallery() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");

    document.body.style.overflow = "";

    currentGallery = null;
  }

  document.querySelectorAll("[data-gallery]").forEach((button) => {
    button.addEventListener("click", () => {
      openGallery(button.dataset.gallery);
    });
  });

  close.addEventListener("click", closeGallery);

  prev.addEventListener("click", () => {
    showImage(currentIndex - 1);
  });

  next.addEventListener("click", () => {
    showImage(currentIndex + 1);
  });

  modal.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeGallery();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!currentGallery) return;

    if (event.key === "Escape") {
      closeGallery();
    }

    if (event.key === "ArrowLeft") {
      showImage(currentIndex - 1);
    }

    if (event.key === "ArrowRight") {
      showImage(currentIndex + 1);
    }
  });
</script>
  </body>
</html>
