---
import "../styles/global.css";

const categories = [
  {
    id: "loft",
    image: "/optimized/categories/cat-01-loft-mebel.webp",
    title: "Лофт-мебель",
    description: "Столы, стеллажи, кровати и мебель из металла",
    gallery: Array.from({ length: 8 }, (_, i) =>
      `/optimized/products/loft/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "mangals",
    image: "/optimized/categories/cat-02-mangal-zony-otdyha.webp",
    title: "Мангалы и зоны отдыха",
    description: "Мангалы, мангальные комплексы и зоны отдыха",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/mangals/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "fences",
    image: "/optimized/categories/cat-03-zabor-vorota.webp",
    title: "Заборы и ворота",
    description: "Изготовление и монтаж металлических конструкций",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/fences/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "benches",
    image: "/optimized/categories/cat-04-skameyki-kacheli.webp",
    title: "Скамейки и качели",
    description: "Для частных участков, парков и общественных пространств",
    gallery: Array.from({ length: 12 }, (_, i) =>
      `/optimized/products/benches/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "perila",
    image: "/optimized/categories/cat-05-perila-ograzhdeniya.webp",
    title: "Перила",
    description: "Металлические перила для лестниц, крылец и балконов",
    gallery: Array.from({ length: 25 }, (_, i) =>
      `/optimized/products/perila/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "ograzhdeniya",
    image: "/optimized/categories/cat-10-ograzhdeniya.webp",
    title: "Ограждения",
    description: "Металлические ограждения для участков и общественных пространств",
    svoDiscount: true,
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/ograzhdeniya/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "svetilniki",
    image: "/optimized/categories/cat-06-svetilniki.webp",
    title: "Светильники",
    description: "Люстры, бра и декоративные светильники",
    gallery: Array.from({ length: 8 }, (_, i) =>
      `/optimized/products/svetilniki/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "chany",
    image: "/optimized/categories/cat-07-chany-podogrevom.webp",
    title: "Чаны с подогревом",
    description: "Чаны для воды с системой обогрева",
    gallery: Array.from({ length: 6 }, (_, i) =>
      `/optimized/products/chany/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "besedka",
    image: "/optimized/categories/cat-08-garazhi-besedki.webp",
    title: "Беседки",
    description: "Металлические беседки по индивидуальным размерам",
    gallery: Array.from({ length: 4 }, (_, i) =>
      `/optimized/products/besedka/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
  {
    id: "navesy",
    image: "/optimized/categories/cat-09-navesy.webp",
    title: "Навесы",
    description: "Металлические навесы для автомобилей, домов и участков",
    gallery: Array.from({ length: 4 }, (_, i) =>
      `/optimized/products/navesy/${String(i + 1).padStart(2, "0")}.webp`
    ),
  },
];
const advantages = [
  {
    title: "Собственное производство",
    description: "Изготавливаем металлические конструкции в Якутске",
    icon: "factory",
  },
  {
    title: "Индивидуальные размеры",
    description: "Изготовление по вашим размерам и требованиям",
    icon: "ruler",
  },
  {
    title: "Разные материалы",
    description: "Работаем с металлом, деревом и ЛДСП",
    icon: "layers",
  },
  {
    title: "Доставка и монтаж",
    description: "Доставим конструкцию и установим на месте",
    icon: "truck",
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BVV2EJZHP0"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BVV2EJZHP0');
</script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ПрофиСталь 14 — изготовление изделий и конструкций из металла на заказ в Якутске."
    />
    <title>ПрофиСталь 14 — изделия из металла на заказ</title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32" href={`/favicon.ico?v=ps14-2`} />
    <link rel="icon" type="image/png" sizes="180x180" href={`/favicon.png?v=ps14-2`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`/favicon.svg?v=ps14-2`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`/favicon-animated.svg?v=ps14-2`} />
  </head>

  <body class="bg-brand-bg text-brand-text antialiased">

    <!-- HEADER -->
    <header class="absolute left-0 top-0 z-50 w-full">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-5 py-5 sm:px-6 sm:py-6 lg:px-8">

        <a href="/" class="group block shrink-0">
          <img
            src={`/profistal14_logo.webp`}
            alt="ПрофиСталь 14"
            class="h-auto w-[124px] object-contain transition-opacity group-hover:opacity-85 sm:w-[180px] md:w-[220px]"
          />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-brand-muted md:flex">
          <a href="#catalog" class="transition hover:text-brand-text">Изделия</a>
          <a href="#works" class="transition hover:text-brand-text">Работы</a>
          <a href="#about" class="transition hover:text-brand-text">О компании</a>
          <a href="#contacts" class="transition hover:text-brand-text">Контакты</a>
        </nav>

        <a
          href="#order"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full bg-brand-accent px-3 py-2 text-xs font-bold text-white transition hover:bg-brand-accent-dark sm:px-5 sm:py-2.5 sm:text-sm"
        >
          Заказать
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-brand-border text-brand-text transition hover:border-brand-accent hover:text-brand-accent md:hidden"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <svg id="mobile-menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="mobile-menu-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-5 w-5" aria-hidden="true">
            <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>

      </div>

      <nav
        id="mobile-navigation"
        aria-label="Основная навигация"
        class="absolute left-4 right-4 top-full hidden rounded-2xl border border-brand-border bg-brand-bg p-2 shadow-xl md:hidden"
        inert
      >
        <a href="#catalog" class="block rounded-xl px-4 py-3 font-medium text-brand-text transition hover:bg-brand-section">Изделия</a>
        <a href="#works" class="block rounded-xl px-4 py-3 font-medium text-brand-text transition hover:bg-brand-section">Работы</a>
        <a href="#about" class="block rounded-xl px-4 py-3 font-medium text-brand-text transition hover:bg-brand-section">О компании</a>
        <a href="#contacts" class="block rounded-xl px-4 py-3 font-medium text-brand-text transition hover:bg-brand-section">Контакты</a>
      </nav>
    </header>


    <!-- HERO -->
    <main>

<section data-paper-layer="1" class="hero-section paper-section relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-brand-bg md:flex-row md:justify-start">

  <!-- Animated profiled-metal linework -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <img
      src={`/optimized/hero-bg.webp`}
      alt=""
      class="absolute inset-0 h-full w-full scale-105 object-cover blur-[2px]"
    />
    <div class="hero-photo-wash absolute inset-0"></div>
    <svg class="hero-metal-background absolute inset-0 h-full w-full opacity-65" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="presentation">
      <defs>
        <linearGradient id="hero-metal-glint" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#d9915e" stop-opacity="0.02" />
          <stop offset="0.48" stop-color="#e6a16d" stop-opacity="0.78" />
          <stop offset="1" stop-color="#d9915e" stop-opacity="0.02" />
        </linearGradient>
        <path id="hero-profile-line" d="M-120 330 C40 280 160 278 300 318 S535 396 690 350 S980 238 1140 282 S1430 394 1730 315" />
        <path id="hero-arc-line" d="M-120 630 C105 590 240 504 390 508 S675 624 850 592 S1138 466 1320 480 S1530 548 1730 518" />
      </defs>
      <g class="hero-metal-contours" fill="none" stroke="#53616a" stroke-opacity="0.18" stroke-width="1.2">
        <use href="#hero-profile-line" />
        <use href="#hero-profile-line" transform="translate(0 28)" />
        <use href="#hero-profile-line" transform="translate(0 56)" />
        <use href="#hero-profile-line" transform="translate(0 84)" />
        <use href="#hero-profile-line" transform="translate(0 112)" />
        <use href="#hero-profile-line" transform="translate(0 140)" />
        <use href="#hero-profile-line" transform="translate(0 168)" />
        <use href="#hero-profile-line" transform="translate(0 196)" />
        <use href="#hero-arc-line" transform="translate(0 -84)" />
        <use href="#hero-arc-line" transform="translate(0 -56)" />
        <use href="#hero-arc-line" transform="translate(0 -28)" />
        <use href="#hero-arc-line" />
        <use href="#hero-arc-line" transform="translate(0 28)" />
        <use href="#hero-arc-line" transform="translate(0 56)" />
        <use href="#hero-arc-line" transform="translate(0 84)" />
      </g>

      <g class="hero-metal-contours-secondary" fill="none" stroke="#955b39" stroke-opacity="0.24" stroke-width="1.1">
        <g class="hero-contour-drift-line hero-contour-drift-line-slow">
          <use href="#hero-profile-line" transform="translate(0 -16)" />
        </g>
        <g class="hero-contour-drift-line hero-contour-drift-line-fast">
          <use href="#hero-profile-line" transform="translate(0 126)" />
        </g>
        <g class="hero-contour-drift-line hero-contour-drift-line-mid">
          <use href="#hero-arc-line" transform="translate(0 -70)" />
        </g>
      </g>

      <g class="hero-metal-glints" fill="none" stroke="url(#hero-metal-glint)" stroke-width="1.8">
        <use href="#hero-profile-line" transform="translate(0 28)" />
        <use href="#hero-arc-line" transform="translate(0 -28)" />
      </g>

    </svg>
    <div class="hero-metal-shade absolute inset-0"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pt-32 pb-0 sm:px-6 md:py-32 lg:px-8">

    <div class="max-w-4xl">

      <div class="mb-7 flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.25em] text-brand-accent">
        <span class="h-px w-10 bg-brand-accent"></span>
        Изделия из металла
      </div>

<h1 class="hero-title-shimmer relative min-w-0 max-w-full text-[clamp(1.875rem,9vw,2.25rem)] font-black leading-[1.12] tracking-tight text-brand-text sm:text-7xl lg:text-8xl">
  МЕТАЛЛ,<br>
  КОТОРЫЙ
  <span class="block text-brand-accent sm:inline">РАБОТАЕТ.</span>
  <span class="hero-title-shimmer-layer" aria-hidden="true">
    МЕТАЛЛ,<br>
    КОТОРЫЙ
    <span class="block sm:inline">РАБОТАЕТ.</span>
  </span>
</h1>

      <p class="mt-6 w-full min-w-0 max-w-xl break-words text-base leading-relaxed text-brand-muted sm:mt-8 sm:text-lg">
        Изготавливаем изделия и конструкции из металла
        по вашим размерам и проектам — от небольшой
        детали до комплексного объекта.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:flex-wrap sm:gap-4">
        <a
          href="#catalog"
          class="hero-shimmer-button relative isolate inline-flex min-h-14 w-full items-center justify-center overflow-hidden rounded-full bg-brand-accent px-5 py-3 text-center font-bold text-white transition hover:bg-brand-accent-dark sm:w-auto sm:px-7 sm:py-4"
        >
          <span class="relative z-10">Смотреть изделия</span>
        </a>

        <a
          href="#order"
          class="hero-outline-shimmer-button relative isolate inline-flex min-h-14 w-full items-center justify-center overflow-hidden rounded-full border border-brand-border px-5 py-3 text-center font-bold text-brand-text transition hover:border-brand-accent hover:text-brand-accent sm:w-auto sm:px-7 sm:py-4"
        >
          <span class="relative z-10">Рассчитать стоимость</span>
        </a>
      </div>

    </div>

  </div>

  <div class="relative z-10 mx-auto mt-4 flex w-full max-w-7xl shrink-0 justify-between px-6 pb-16 text-xs uppercase tracking-[0.2em] text-brand-muted md:absolute md:bottom-8 md:left-6 md:right-6 md:mt-0 md:w-auto md:px-0 md:pb-0 lg:left-8 lg:right-8">
    <span>ПРОФИСТАЛЬ 14</span>
    <span class="hidden sm:block">ЯКУТСК</span>
  </div>

</section>


      <!-- CATALOG -->
      <section id="catalog" data-paper-layer="2" class="paper-section bg-brand-section pt-16 pb-24 lg:pt-24 lg:pb-32">

        <div class="mx-auto max-w-7xl px-6 md:pb-10 lg:px-8">

          <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">

            <div>
              <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
                Каталог
              </p>

              <h2 class="sequence-wave-title text-4xl font-black tracking-tight sm:text-5xl">
                <span class="title-wave-line">ЧТО МЫ ДЕЛАЕМ<span class="title-wave-highlight" aria-hidden="true">ЧТО МЫ ДЕЛАЕМ</span></span>
              </h2>
            </div>

            <p class="max-w-md text-brand-muted">
              Изготавливаем изделия серийно и по индивидуальным
              проектам. Если нужного варианта нет в каталоге —
              просто расскажите нам свою идею.
            </p>

          </div>


<div
  id="catalog-grid"
  class="grid overflow-hidden rounded-t-2xl bg-white sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5"
  data-categories={JSON.stringify(categories)}
>
  {categories.map((category) => (
    <button
      type="button"
      class="category-card group relative min-h-[320px] overflow-hidden bg-[#f5f3ef] text-left"
      data-category-id={category.id}
    >
      <div class="absolute inset-0 flex items-center justify-center p-5">
        <img
          src={category.image}
          alt={category.title}
          loading="lazy"
          class="h-full w-full object-contain transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-white via-white/75 via-35% to-transparent"></div>

      <div class="relative flex min-h-[320px] flex-col justify-end p-6">
        <h3 class="text-xl font-bold leading-tight text-brand-text">
          {category.title}
        </h3>

        <p class="mt-3 max-w-[280px] text-sm leading-relaxed text-brand-muted">
          {category.description}
        </p>

        <div class="mt-6 flex items-center justify-between">
          <span class="wave-label catalog-wave-label text-sm font-bold text-brand-accent">
            Смотреть работы
          </span>

          <span class="text-xl text-brand-muted/50 transition-all duration-300 group-hover:translate-x-1 group-hover:text-brand-accent">
            →
          </span>
        </div>
      </div>
    </button>
  ))}
</div>
</div>
      </section>
<!-- Category gallery modal -->
<div
  id="category-modal"
  class="fixed inset-0 z-[100] hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="category-modal-title"
  aria-describedby="category-modal-count"
  tabindex="-1"
>
  <!-- Background -->
  <div
    id="category-modal-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  ></div>

  <!-- Modal -->
  <div class="relative flex min-h-full items-center justify-center p-3 sm:p-6">
    <div
      id="category-modal-panel"
      class="relative flex max-h-[94vh] w-full max-w-6xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
    >
      <!-- Header -->
      <div class="flex shrink-0 items-center justify-between border-b border-brand-border px-5 py-4 sm:px-7">
        <div>
          <h2
            id="category-modal-title"
            class="text-xl font-bold text-brand-text sm:text-2xl"
          ></h2>

          <p
            id="category-modal-count"
            class="mt-1 text-sm text-brand-muted"
          ></p>
        </div>

        <button
          id="category-modal-close"
          type="button"
          aria-label="Закрыть"
          class="grid box-border h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-bg p-0 text-brand-text transition hover:bg-brand-border"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            class="block h-5 w-5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <!-- Gallery -->
      <div
        id="category-modal-gallery"
        class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6"
      >
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        </div>
      </div>

      <!-- Footer -->
<div class="shrink-0 border-t border-brand-border bg-white px-5 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-7 sm:py-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <button
      id="category-modal-order"
      type="button"
      class="w-full rounded-xl bg-brand-accent px-6 py-3.5 text-center text-sm font-bold text-white transition hover:opacity-90 sm:w-auto"
    >
      Заказать
    </button>

    <p
      id="category-modal-discount"
      class="hidden text-center text-sm italic text-brand-muted sm:text-left"
    >
      Для участников СВО действует система скидок
    </p>
  </div>
</div>
    </div>
  </div>
</div>

<!-- ADVANTAGES -->
<section data-paper-layer="3" class="paper-section border-y border-brand-border bg-white py-20 lg:py-24">

  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <!-- Section heading -->
    <div class="mb-12 max-w-2xl lg:mb-14">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-accent">
        Почему мы
      </p>

      <h2 class="sequence-wave-title mt-3 text-3xl font-black tracking-tight text-brand-text sm:text-4xl lg:text-5xl">
        <span class="title-wave-line">Делаем надёжно<span class="title-wave-highlight" aria-hidden="true">Делаем надёжно</span></span>
        <span class="title-wave-line">и под ваши задачи<span class="title-wave-highlight" aria-hidden="true">и под ваши задачи</span></span>
      </h2>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-brand-muted">
        Собственное производство, индивидуальные размеры и полный цикл работ —
        от изготовления до доставки и монтажа.
      </p>
    </div>

    <!-- Advantages -->
    <div class="divide-y divide-brand-border border-y border-brand-border">

      {advantages.map((advantage) => (
        <div
          class="flex items-center gap-5 px-1 py-6 sm:gap-6 sm:px-3"
        >

          <!-- Icon -->
          <div
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-bg text-brand-accent sm:h-16 sm:w-16"
          >

            {advantage.icon === "factory" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                class="h-7 w-7 sm:h-8 sm:w-8"
                aria-hidden="true"
              >
                <path d="M3 21h18" />
                <path d="M4 21V9l6 3V8l6 3V6l4 2v13" />
                <path d="M8 21v-4h3v4" />
                <path d="M15 15h2" />
                <path d="M15 18h2" />
              </svg>
            )}

            {advantage.icon === "ruler" && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                class="h-7 w-7 sm:h-8 sm:w-8"
                aria-hidden="true"
              >
                <path d="M4 20L20 4" />
                <path d="M7 17l-2-2" />
                <path d="M10 14l-2-2" />
                <path d="M13 11l-2-2" />
                <path d="M16 8l-2-2" />
