    <script>
      const form = document.querySelector("#order-form");
      const submitButton = document.querySelector("#order-submit");
      const status = document.querySelector("#order-status");
      const frame = document.querySelector("#form-submit-frame");

      let submitted = false;

      form?.addEventListener("submit", () => {
        if (!form || !submitButton || !status) return;

        submitted = true;

        submitButton.disabled = true;
        submitButton.textContent = "Отправляем...";

        status.classList.add("hidden");
        status.textContent = "";
      });

      frame?.addEventListener("load", () => {
        if (!submitted || !form || !submitButton || !status) return;

        submitted = false;

        form.reset();

        submitButton.disabled = false;
        submitButton.textContent = "Отправить заявку";

        status.textContent =
          "Заявка отправлена! Мы свяжемся с вами для уточнения деталей.";

        status.classList.remove("hidden");
      });
    </script>
<script>
  const galleries = {
    production: {
      title: "Производство",
      images: [
        `/optimized/gallery/production/01.webp`,
        `/optimized/gallery/production/02.webp`,
        `/optimized/gallery/production/03.webp`,
        `/optimized/gallery/production/04.webp`,
      ],
    },

    works: {
      title: "Готовые проекты",
      images: [
        `/optimized/gallery/works/01.webp`,
        `/optimized/gallery/works/02.webp`,
        `/optimized/gallery/works/03.webp`,
        `/optimized/gallery/works/04.webp`,
        `/optimized/gallery/works/05.webp`,
        `/optimized/gallery/works/06.webp`,
        `/optimized/gallery/works/07.webp`,
        `/optimized/gallery/works/08.webp`,
        `/optimized/gallery/works/09.webp`,
        `/optimized/gallery/works/10.webp`,
        `/optimized/gallery/works/11.webp`,
        `/optimized/gallery/works/12.webp`,
        `/optimized/gallery/works/13.webp`,
        `/optimized/gallery/works/14.webp`,
        `/optimized/gallery/works/15.webp`,
        `/optimized/gallery/works/16.webp`,
      ],
    },
  };

  const modal = document.querySelector("#gallery-modal");
  const image = document.querySelector("#gallery-image");
  const title = document.querySelector("#gallery-title");
  const thumbnails = document.querySelector("#gallery-thumbnails");
  const close = document.querySelector("#gallery-close");
  const prev = document.querySelector("#gallery-prev");
  const next = document.querySelector("#gallery-next");

  let currentGallery = null;
  let currentIndex = 0;

  function showImage(index) {
    if (!currentGallery) return;

    currentIndex =
      (index + currentGallery.images.length) %
      currentGallery.images.length;

    image.src = currentGallery.images[currentIndex];

    thumbnails.innerHTML = "";

    currentGallery.images.forEach((src, i) => {
      const thumb = document.createElement("button");

      thumb.type = "button";
      thumb.className =
        "h-20 w-28 shrink-0 overflow-hidden rounded-lg border-2 transition";

      if (i === currentIndex) {
        thumb.classList.add("border-brand-accent");
      } else {
        thumb.classList.add("border-transparent");
      }

      const img = document.createElement("img");

      img.src = src;
      img.alt = "";
      img.className = "h-full w-full object-cover";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        showImage(i);
      });

      thumbnails.appendChild(thumb);
    });
  }

  function openGallery(name) {
    currentGallery = galleries[name];

    if (!currentGallery) return;

    currentIndex = 0;
    title.textContent = currentGallery.title;

    showImage(0);

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.body.style.overflow = "hidden";
  }

  function closeGallery() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");

    document.body.style.overflow = "";

    currentGallery = null;
  }

  document.querySelectorAll("[data-gallery]").forEach((button) => {
    button.addEventListener("click", () => {
      openGallery(button.dataset.gallery);
    });
  });

  close.addEventListener("click", closeGallery);

  prev.addEventListener("click", () => {
    showImage(currentIndex - 1);
  });

  next.addEventListener("click", () => {
    showImage(currentIndex + 1);
  });

  modal.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeGallery();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!currentGallery) return;

    if (event.key === "Escape") {
      closeGallery();
    }

    if (event.key === "ArrowLeft") {
      showImage(currentIndex - 1);
    }

    if (event.key === "ArrowRight") {
      showImage(currentIndex + 1);
    }
  });
</script>

<script>
  const catalogGrid = document.querySelector("#catalog-grid");
  const categoryModal = document.querySelector("#category-modal");
  const categoryModalBackdrop = document.querySelector(
    "#category-modal-backdrop"
  );
  const categoryModalClose = document.querySelector("#category-modal-close");
  const categoryModalOrder = document.querySelector("#category-modal-order");
  const categoryModalTitle = document.querySelector("#category-modal-title");
  const categoryModalCount = document.querySelector("#category-modal-count");
  const categoryModalGallery = document.querySelector(
    "#category-modal-gallery > div"
  );

  if (
    catalogGrid &&
    categoryModal &&
    categoryModalClose &&
    categoryModalOrder &&
    categoryModalGallery
  ) {
    const categories = JSON.parse(
      catalogGrid.getAttribute("data-categories") || "[]"
    );

    let currentCategory = null;

    function openCategoryModal(category) {
      currentCategory = category;

      categoryModalTitle.textContent = category.title;
      categoryModalCount.textContent = `${category.gallery.length} фото`;

      categoryModalGallery.innerHTML = "";

      category.gallery.forEach((image, index) => {
        const wrapper = document.createElement("div");

        wrapper.className =
          "group relative overflow-hidden rounded-xl bg-brand-bg";

        const img = document.createElement("img");

        img.src = image;
        img.alt = `${category.title} — фото ${index + 1}`;
        img.loading = index === 0 ? "eager" : "lazy";
        img.className =
          "block h-auto w-full cursor-zoom-in object-cover transition-transform duration-500 group-hover:scale-[1.02]";

        wrapper.appendChild(img);
        categoryModalGallery.appendChild(wrapper);
      });

      categoryModal.classList.remove("hidden");
      categoryModal.setAttribute("aria-hidden", "false");

      document.body.classList.add("overflow-hidden");
    }

    function closeCategoryModal() {
      categoryModal.classList.add("hidden");
      categoryModal.setAttribute("aria-hidden", "true");

      document.body.classList.remove("overflow-hidden");

      currentCategory = null;
    }

    catalogGrid.addEventListener("click", (event) => {
      const card = event.target.closest("[data-category-id]");

      if (!card) return;

      const category = categories.find(
        (item) => item.id === card.dataset.categoryId
      );

      if (category) {
        openCategoryModal(category);
      }
    });

    categoryModalClose.addEventListener("click", closeCategoryModal);

    categoryModalBackdrop.addEventListener("click", closeCategoryModal);

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !categoryModal.classList.contains("hidden")
      ) {
        closeCategoryModal();
      }
    });

    categoryModalOrder.addEventListener("click", () => {
      closeCategoryModal();

      const orderSection = document.querySelector("#order");

      if (orderSection) {
        orderSection.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }

      setTimeout(() => {
        const firstInput = document.querySelector(
          "#order input:not([type='hidden'])"
        );

        if (firstInput) {
          firstInput.focus();
        }
      }, 700);
    });
  }
</script>

