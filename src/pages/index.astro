        `/optimized/products/perila/18.webp`,
      ],
    },

    works: {
      title: "Готовые проекты",
      images: [
        `/optimized/gallery/works/01.webp`,
        `/optimized/gallery/works/02.webp`,
        `/optimized/gallery/works/03.webp`,
        `/optimized/gallery/works/04.webp`,
        `/optimized/gallery/works/05.webp`,
        `/optimized/gallery/works/06.webp`,
        `/optimized/gallery/works/07.webp`,
        `/optimized/gallery/works/08.webp`,
        `/optimized/gallery/works/09.webp`,
        `/optimized/gallery/works/10.webp`,
        `/optimized/gallery/works/11.webp`,
        `/optimized/gallery/works/12.webp`,
        `/optimized/gallery/works/13.webp`,
        `/optimized/gallery/works/14.webp`,
        `/optimized/gallery/works/15.webp`,
        `/optimized/gallery/works/16.webp`,
      ],
    },
  };

  const modal = document.querySelector("#gallery-modal");
  const image = document.querySelector("#gallery-image");
  const position = document.querySelector("#gallery-position");
  const title = document.querySelector("#gallery-title");
  const thumbnails = document.querySelector("#gallery-thumbnails");
  const close = document.querySelector("#gallery-close");
  const prev = document.querySelector("#gallery-prev");
  const next = document.querySelector("#gallery-next");

  let currentGallery = null;
  let currentIndex = 0;
  let previousFocus = null;
  let previousBodyOverflow = "";
  let inertedElements = [];

  thumbnails?.addEventListener(
    "wheel",
    (event) => {
      const maxScrollLeft = thumbnails.scrollWidth - thumbnails.clientWidth;
      if (maxScrollLeft <= 0) return;

      // Leave pure horizontal trackpad gestures to the browser's native scrolling.
      if (event.deltaX !== 0 && event.deltaY === 0) return;

      const delta = event.deltaX || event.deltaY;
      if (delta === 0) return;

      const canScrollInDirection =
        delta < 0 ? thumbnails.scrollLeft > 0 : thumbnails.scrollLeft < maxScrollLeft;
      if (!canScrollInDirection) return;

      const unit =
        event.deltaMode === WheelEvent.DOM_DELTA_LINE
          ? Number.parseFloat(getComputedStyle(thumbnails).lineHeight) || 16
          : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
            ? thumbnails.clientWidth
            : 1;

      event.preventDefault();
      thumbnails.scrollLeft += delta * unit;
    },
    { passive: false }
  );

  function inertDialogBackground(dialog) {
    const inerted = [];
    let branch = dialog;

    while (branch && branch !== document.body) {
      const parent = branch.parentElement;
      if (!parent) break;

      for (const sibling of parent.children) {
        if (sibling === branch) continue;
        inerted.push([sibling, sibling.inert]);
        sibling.inert = true;
      }

      branch = parent;
    }

    return inerted;
  }

  function focusableElements(container) {
    return [...container.querySelectorAll(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )].filter((element) => !element.hasAttribute("hidden"));
  }

  function activateGalleryDialog(trigger) {
    previousFocus =
      trigger instanceof HTMLElement ? trigger : document.activeElement;
    previousBodyOverflow = document.body.style.overflow;
    inertedElements = inertDialogBackground(modal);

    modal.inert = false;
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    close.focus();
  }

  function deactivateGalleryDialog() {
    modal.setAttribute("aria-hidden", "true");
    inertedElements.forEach(([element, wasInert]) => {
      element.inert = wasInert;
    });
    inertedElements = [];
    document.body.style.overflow = previousBodyOverflow;

    if (previousFocus instanceof HTMLElement) previousFocus.focus();
    previousFocus = null;
  }

  function showImage(index) {
    if (!currentGallery) return;

    currentIndex =
      (index + currentGallery.images.length) %
      currentGallery.images.length;

    image.src = currentGallery.images[currentIndex];
    image.alt = `${currentGallery.title} — фотография ${currentIndex + 1} из ${currentGallery.images.length}`;
    position.textContent = `Фотография ${currentIndex + 1} из ${currentGallery.images.length}`;

    thumbnails.innerHTML = "";

    currentGallery.images.forEach((src, i) => {
      const thumb = document.createElement("button");

      thumb.type = "button";
      thumb.setAttribute(
        "aria-label",
        `Фотография ${i + 1} из ${currentGallery.images.length}`
      );
      thumb.setAttribute("aria-pressed", String(i === currentIndex));
      thumb.className =
        "h-20 w-28 shrink-0 overflow-hidden rounded-lg border-2 transition";

      if (i === currentIndex) {
        thumb.classList.add("border-brand-accent");
      } else {
        thumb.classList.add("border-transparent");
      }

      const img = document.createElement("img");

      img.src = src;
      img.alt = "";
      img.className = "h-full w-full object-cover";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        showImage(i);
      });

      thumbnails.appendChild(thumb);
    });
  }

  function openGallery(name, trigger) {
    currentGallery = galleries[name];

    if (!currentGallery) return;

    currentIndex = 0;
    title.textContent = currentGallery.title;

    showImage(0);

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    activateGalleryDialog(trigger);
  }

  function closeGallery() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    deactivateGalleryDialog();

    currentGallery = null;
  }

  document.querySelectorAll("[data-gallery]").forEach((button) => {
    button.addEventListener("click", () => {
      openGallery(button.dataset.gallery, button);
    });
  });

  close.addEventListener("click", closeGallery);

  prev.addEventListener("click", () => {
    showImage(currentIndex - 1);
  });

  next.addEventListener("click", () => {
    showImage(currentIndex + 1);
  });

  modal.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeGallery();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!currentGallery) return;

    if (event.key === "Escape") {
      event.preventDefault();
      closeGallery();
      return;
    }

    if (event.key === "Tab") {
      const focusable = focusableElements(modal);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
      return;
    }

    if (event.key === "ArrowLeft") {
      event.preventDefault();
      showImage(currentIndex - 1);
    }

    if (event.key === "ArrowRight") {
      event.preventDefault();
      showImage(currentIndex + 1);
    }
  });
</script>

<script>
  const catalogGrid = document.querySelector("#catalog-grid");
  const categoryModal = document.querySelector("#category-modal");
  const categoryModalBackdrop = document.querySelector(
    "#category-modal-backdrop"
  );
  const categoryModalPanel = document.querySelector("#category-modal-panel");
  const categoryModalClose = document.querySelector("#category-modal-close");
  const categoryModalOrder = document.querySelector("#category-modal-order");
  const categoryModalTitle = document.querySelector("#category-modal-title");
  const categoryModalCount = document.querySelector("#category-modal-count");
  const categoryModalGallery = document.querySelector(
    "#category-modal-gallery > div"
  );
  const categoryModalDiscount = document.querySelector(
  "#category-modal-discount"
);

  let previousCategoryFocus = null;
  let previousCategoryBodyOverflow = "";
  let inertedCategorySiblings = [];

  function inertCategoryDialogBackground(dialog) {
    const inerted = [];
    let branch = dialog;

    while (branch && branch !== document.body) {
      const parent = branch.parentElement;
      if (!parent) break;

      for (const sibling of parent.children) {
        if (sibling === branch) continue;
        inerted.push([sibling, sibling.inert]);
        sibling.inert = true;
      }

      branch = parent;
    }

    return inerted;
  }

  function categoryModalFocusableElements() {
    return [...categoryModal.querySelectorAll(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    )].filter((element) => !element.hasAttribute("hidden"));
  }

  function activateCategoryDialog(trigger) {
    previousCategoryFocus =
      trigger instanceof HTMLElement ? trigger : document.activeElement;
    previousCategoryBodyOverflow = document.body.style.overflow;
    inertedCategorySiblings = inertCategoryDialogBackground(categoryModal);

    categoryModal.inert = false;
    categoryModal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    categoryModalClose.focus();
  }

  function deactivateCategoryDialog() {
    categoryModal.setAttribute("aria-hidden", "true");
    inertedCategorySiblings.forEach(([element, wasInert]) => {
      element.inert = wasInert;
    });
    inertedCategorySiblings = [];
    document.body.style.overflow = previousCategoryBodyOverflow;

    if (previousCategoryFocus instanceof HTMLElement) {
      previousCategoryFocus.focus();
    }
    previousCategoryFocus = null;
  }

  if (
    catalogGrid &&
    categoryModal &&
    categoryModalPanel &&
    categoryModalClose &&
    categoryModalOrder &&
    categoryModalGallery
  ) {
    const categories = JSON.parse(
      catalogGrid.getAttribute("data-categories") || "[]"
    );

    let currentCategory = null;

    function openCategoryModal(category, trigger) {
      currentCategory = category;

      categoryModalTitle.textContent = category.title;
      categoryModalCount.textContent = `${category.gallery.length} фото`;

      categoryModalGallery.innerHTML = "";

      category.gallery.forEach((image, index) => {
        const wrapper = document.createElement("div");

        wrapper.className =
          "group relative overflow-hidden rounded-xl bg-brand-bg";

        const img = document.createElement("img");

        img.src = image;
        img.alt = `${category.title} — фото ${index + 1}`;
        img.loading = index === 0 ? "eager" : "lazy";
        img.className =
          "block h-auto w-full cursor-zoom-in object-cover transition-transform duration-500 group-hover:scale-[1.02]";

        wrapper.appendChild(img);
        categoryModalGallery.appendChild(wrapper);
      });

      categoryModal.classList.remove("hidden");
      activateCategoryDialog(trigger);
      if (categoryModalDiscount) {
  categoryModalDiscount.classList.toggle(
    "hidden",
    !category.svoDiscount
  );
}
    }

    function closeCategoryModal() {
      categoryModal.classList.add("hidden");
      deactivateCategoryDialog();

      currentCategory = null;
    }

    catalogGrid.addEventListener("click", (event) => {
      const card = event.target.closest("[data-category-id]");

      if (!card) return;

      const category = categories.find(
        (item) => item.id === card.dataset.categoryId
      );

      if (category) {
        openCategoryModal(category, card);
      }
    });

    categoryModalClose.addEventListener("click", closeCategoryModal);

    categoryModal.addEventListener("click", (event) => {
      if (
        event.target === categoryModalBackdrop ||
        !categoryModalPanel.contains(event.target)
      ) {
        closeCategoryModal();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        !categoryModal.classList.contains("hidden")
      ) {
        event.preventDefault();
        closeCategoryModal();
        return;
      }

      if (
        event.key === "Tab" &&
        !categoryModal.classList.contains("hidden")
      ) {
        const focusable = categoryModalFocusableElements();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    categoryModalOrder.addEventListener("click", () => {
      closeCategoryModal();

      const orderSection = document.querySelector("#order");

      if (orderSection) {
        orderSection.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      }

      setTimeout(() => {
        const firstInput = document.querySelector(
          "#order input:not([type='hidden'])"
        );

        if (firstInput) {
          firstInput.focus();
        }
      }, 700);
    });
  }
</script>

<script>
  (() => {
    const ambientGroups = [
      Array.from(document.querySelectorAll("#catalog-grid .catalog-wave-label")),
      Array.from(document.querySelectorAll(".title-wave-label")),
    ].filter((group) => group.length > 0);

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const activeIndices = ambientGroups.map(() => -1);
    let ambientTimer = null;

    function activateCurrent() {
      ambientGroups.forEach((labels, groupIndex) => {
        if (activeIndices[groupIndex] < 0) activeIndices[groupIndex] = 0;
        labels[activeIndices[groupIndex]].classList.add("is-wave-active");
      });
    }

    function stopCycle() {
      if (ambientTimer !== null) {
        window.clearInterval(ambientTimer);
        ambientTimer = null;
      }

      ambientGroups.forEach((labels) =>
        labels.forEach((label) => label.classList.remove("is-wave-active"))
      );
    }

    function startCycle() {
      if (
        ambientGroups.length === 0 ||
        ambientTimer !== null ||
        reducedMotion.matches ||
        document.hidden
      ) return;

      activateCurrent();

      ambientTimer = window.setInterval(() => {
        ambientGroups.forEach((labels, groupIndex) => {
          labels[activeIndices[groupIndex]].classList.remove("is-wave-active");
          activeIndices[groupIndex] =
            (activeIndices[groupIndex] + 1) % labels.length;
          labels[activeIndices[groupIndex]].classList.add("is-wave-active");
        });
      }, 3000);
    }

    const advantageWaveTitles = Array.from(
      document.querySelectorAll(".advantage-wave-title")
    );
    const shimmerSequence = [
      { element: document.querySelector(".hero-title-shimmer"), duration: 1400 },
      { element: document.querySelector(".hero-shimmer-button"), duration: 1000 },
      { element: document.querySelector(".hero-outline-shimmer-button"), duration: 1000 },
      { element: document.querySelector("#catalog .sequence-wave-title"), duration: 1350 },
      {
        element: document.querySelector(
          ".paper-section[data-paper-layer='3'] .sequence-wave-title"
        ),
        duration: 1350,
      },
      ...advantageWaveTitles.map((element) => ({ element, duration: 1000 })),
      { element: document.querySelector("#works .sequence-wave-title"), duration: 1350 },
      { element: document.querySelector(".footer-phone-number"), duration: 1350 },
    ].filter(({ element }) => element);
    let shimmerTimer = null;

    function stopShimmerSequence() {
      if (shimmerTimer !== null) {
        window.clearTimeout(shimmerTimer);
        shimmerTimer = null;
      }

      shimmerSequence.forEach(({ element }) =>
        element.classList.remove("is-wave-active")
      );
    }

    function playShimmerStep(index) {
      const { element, duration } = shimmerSequence[index];
      if (!element || reducedMotion.matches || document.hidden) return;

      element.classList.add("is-wave-active");
      shimmerTimer = window.setTimeout(() => {
        element.classList.remove("is-wave-active");
        const isLastStep = index === shimmerSequence.length - 1;
        const pause = isLastStep ? 3000 : 300;

        shimmerTimer = window.setTimeout(() => {
          shimmerTimer = null;
          playShimmerStep(isLastStep ? 0 : index + 1);
        }, pause);
      }, duration);
    }

    function startShimmerSequence() {
      if (
        shimmerTimer !== null ||
        shimmerSequence.length === 0 ||
        reducedMotion.matches ||
        document.hidden
      ) return;

      playShimmerStep(0);
    }

    function syncAnimations() {
      stopCycle();
      startCycle();
      stopShimmerSequence();
      startShimmerSequence();
    }

    document.addEventListener("visibilitychange", syncAnimations);
    reducedMotion.addEventListener("change", syncAnimations);
    startCycle();
    startShimmerSequence();
  })();
</script>

